  "keyFeatures": [
    "Modular skill folders with SKILL.md instructions, scripts, assets, and reference files",
    "Progressive disclosure: metadata always in context, SKILL.md body loaded on trigger, bundled resources loaded on demand",
    "System skills auto-installed with Codex (imagegen, openai-docs, skill-creator, skill-installer, plugin-creator)",
    "Curated and experimental skill tiers for different maturity levels",
    "skill-installer helper to list and install skills from GitHub by name or URL",
    "openai.yaml agent UI metadata (display_name, short_description, default_prompt, icons, brand_color)",
    "MCP tool dependencies declarable inside agents/openai.yaml",
    "Skill creation tooling: init_skill.py, generate_openai_yaml.py, quick_validate.py"
  ],
  "publicApiSurface": [
    "SKILL.md frontmatter: name, description (YAML)",
    "agents/openai.yaml: interface.display_name, interface.short_description, interface.default_prompt, interface.icon_small, interface.icon_large, interface.brand_color",
    "agents/openai.yaml: dependencies.tools[].type, .value, .description, .transport, .url",
    "scripts/init_skill.py <skill-name> --path <dir> [--resources scripts,references,assets] [--examples] [--interface key=value]",
    "scripts/generate_openai_yaml.py <skill-folder> --interface key=value",
    "scripts/quick_validate.py <skill-folder>",
    "scripts/install-skill-from-github.py --repo <owner>/<repo> --path <path> [--ref <ref>] [--dest <path>] [--method auto|download|git]",
    "scripts/install-skill-from-github.py --url <github-tree-url>",
    "scripts/list-skills.py [--path <folder>] [--format json]",
    "$skill-installer <skill-name> (Codex in-chat install command)",
    "Skill directory layout: SKILL.md (required), agents/ (recommended), scripts/, references/, assets/ (optional)"
  ]
}
